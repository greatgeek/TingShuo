      "lines": [
        {
          "speaker": "A",
          "start_ms": 17332,
          "end_ms": 20768,
          "text": "スーパーで何を買いましたか。",
          "translation": "A：在超市买了什么？"
        },
        {
          "speaker": "B",
          "start_ms": 21563,
          "end_ms": 27310,
          "text": "150円のりんごを２つ買いました。それから120円のアイスクリームを１つ。",
          "translation": "B：买了两个150日元的苹果，还有一个120日元的冰淇淋。"
        },
        {
          "speaker": "A",
          "start_ms": 28239,
          "end_ms": 30545,
          "text": "え？アイスを１つだけ？",
          "translation": "A：诶？冰淇淋只买一个？"
        },
        {
          "speaker": "B",
          "start_ms": 31550,
          "end_ms": 35201,
          "text": "そうですよ。あなたは食べませんよね。",
          "translation": "B：是啊。你不吃吧。"
        },
        {
          "speaker": "A",
          "start_ms": 40157,
          "end_ms": 47334,
          "text": "勉強は忙しいですか。",
          "translation": "A：学习忙吗？"
        },
        {
          "speaker": "B",
          "start_ms": 49832,
          "end_ms": 56939,
          "text": "はい、朝3時間ぐらい勉強します。それから、夜7時から10時まで図書館で勉強します。",
          "translation": "B：忙。早上学3个小时左右，然后晚上7点到10点在图书馆学习。"
        },
        {
          "speaker": "A",
          "start_ms": 57886,
          "end_ms": 60511,
          "text": "すごいですね。",
          "translation": "A：真厉害。"
        },
        {
          "speaker": "A",
          "start_ms": 65457,
          "end_ms": 73339,
          "text": "よく上海に行きますか。",
