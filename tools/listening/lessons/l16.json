      "example": null,
      "questions": [
        {
          "prompt": "女の人は、この後、何をしますか。",
          "options": [
            {
              "key": "a",
              "text": "病院に行きます。"
            },
            {
              "key": "b",
              "text": "休みます。"
            },
            {
              "key": "c",
              "text": "薬を飲みます。"
            }
          ],
          "answer": "c"
        },
        {
          "prompt": "女の人は、今週の日曜日、何をしますか。",
          "options": [
            {
              "key": "a",
              "text": "何もしません。"
            },
            {
              "key": "b",
              "text": "会社で残業します。"
            },
            {
