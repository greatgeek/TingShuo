          ],
          "answer": "b"
        }
      ],
      "lines": [
        {
          "speaker": "男",
          "start_ms": 105650,
          "end_ms": 110536,
          "text": "伊藤さん、大丈夫ですか。顔色が悪いですね。",
          "translation": "男：伊藤，你没事吧？脸色不太好。"
        },
        {
          "speaker": "女",
          "start_ms": 111154,
          "end_ms": 114449,
          "text": "ええ、ちょっと頭が痛いんです。",
          "translation": "女：嗯，有点头疼。"
        },
        {
          "speaker": "男",
          "start_ms": 115356,
          "end_ms": 118096,
          "text": "薬はありますか。",
          "translation": "男：有药吗？"
        },
        {
          "speaker": "女",
          "start_ms": 118097,
          "end_ms": 121533,
          "text": "あ、あります。今、飲みます。",
          "translation": "女：啊，有。我现在就吃。"
        },
        {
          "speaker": "男",
          "start_ms": 126490,
          "end_ms": 131326,
          "text": "この土曜日、何をしますか。",
          "translation": "男：这个周六做什么？"
        },
        {
          "speaker": "女",
          "start_ms": 131717,
          "end_ms": 138517,
          "text": "ええと、今週の土曜日ですね。何もありません。",
          "translation": "女：我想想，这周六啊。没什么安排。"
        },
        {
          "speaker": "男",
          "start_ms": 140326,
          "end_ms": 142426,
          "text": "じゃ、いっしょに博物館へ行きましょうか。",
          "translation": "男：那一起去博物馆吧？"
        },
        {
          "speaker": "女",
          "start_ms": 143290,
          "end_ms": 145920,
          "text": "でも、土曜日は雨ですよね。",
          "translation": "女：可是周六下雨吧。"
        },
        {
          "speaker": "男",
          "start_ms": 147937,
          "end_ms": 149219,
          "text": "えっ？そうですか。じゃ、日曜日は？",
          "translation": "男：诶？是吗。那周日呢？"
        },
        {
          "speaker": "女",
          "start_ms": 149534,
          "end_ms": 150454,
          "text": "日曜日は会社で残業します。",
          "translation": "女：周日要在公司加班。"
        },
        {
          "speaker": "男",
          "start_ms": 151360,
          "end_ms": 153990,
          "text": "そうですか。",
          "translation": "男：这样啊。"
        },
        {
          "speaker": "女",
          "start_ms": 154984,
          "end_ms": 158307,
          "text": "やっぱり土曜日に行きましょうか。",
          "translation": "女：还是周六去吧。"
        }
      ]
    }
