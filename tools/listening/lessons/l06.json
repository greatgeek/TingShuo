              "text": "はい、あります。"
            },
            {
              "key": "b",
              "text": "いいえ、ありません。"
            }
          ],
          "answer": "b"
        },
        {
          "prompt": "自動販売機は社員寮の＿＿階です。",
          "options": [
            {
              "key": "a",
              "text": "1"
            },
            {
              "key": "b",
              "text": "2"
            },
            {
              "key": "c",
              "text": "3"
            }
          ],
          "answer": "b"
        }
      ],
      "lines": [
        {
          "speaker": "管理員",
          "start_ms": 132528,
          "end_ms": 141833,
          "text": "ここはHKK株式会社の社員寮です。",
          "translation": "管理员：这里是 HKK 株式会社的员工宿舍。"
        },
        {
          "speaker": "小林",
          "start_ms": 142926,
          "end_ms": 147811,
          "text": "こんにちは。新入社員の小林です。",
          "translation": "小林：您好。我是新员工小林。"
        },
        {
          "speaker": "管理員",
          "start_ms": 147812,
          "end_ms": 153605,
          "text": "小林さんですか。小林さんの部屋は５階です。こちらは部屋の鍵です。",
          "translation": "管理员：是小林啊。你的房间在5楼，这是房间钥匙。"
        },
        {
          "speaker": "小林",
          "start_ms": 154554,
          "end_ms": 155694,
          "text": "ありがとうございます。",
          "translation": "小林：谢谢。"
        },
        {
          "speaker": "管理員",
          "start_ms": 156489,
          "end_ms": 159219,
          "text": "３階には食堂と会議室があります。",
          "translation": "管理员：3楼有食堂和会议室。"
        },
        {
          "speaker": "小林",
          "start_ms": 159220,
          "end_ms": 164621,
          "text": "わかりました。あのう、Wi-Fiはありますか。",
          "translation": "小林：明白了。请问有 Wi-Fi 吗？"
        },
        {
          "speaker": "管理員",
          "start_ms": 164622,
          "end_ms": 169237,
          "text": "すみません。ここにはWi-Fiはありません。",
          "translation": "管理员：不好意思，这里没有 Wi-Fi。"
        },
        {
          "speaker": "小林",
          "start_ms": 169357,
          "end_ms": 173030,
          "text": "そうですか。じゃ、洗濯機はありますか。",
          "translation": "小林：这样啊。那有洗衣机吗？"
        },
        {
          "speaker": "管理員",
          "start_ms": 173481,
          "end_ms": 176247,
          "text": "あります。２階にあります。それから、自動販売機も２階です。",
          "translation": "管理员：有，在2楼。另外自动售货机也在2楼。"
        },
        {
          "speaker": "小林",
          "start_ms": 176960,
          "end_ms": 180163,
          "text": "わかりました。どうぞ、よろしくお願いします。",
          "translation": "小林：明白了。请多关照。"
        }
      ]
    }
  ]
