      "lines": [
        {
          "speaker": "ヤン",
          "start_ms": 85618,
          "end_ms": 90357,
          "text": "今日はいい天気ですね。",
          "translation": "杨：今天天气真好啊。"
        },
        {
          "speaker": "小林",
          "start_ms": 90660,
          "end_ms": 96086,
          "text": "そうですね。昨日よりちょっと暑いですが。",
