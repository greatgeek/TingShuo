# ===== 数据库（PostgreSQL）=====
DATABASE_URL=postgres://tingshuo:pass@localhost:5432/tingshuo?sslmode=disable

# ===== 对象存储（S3 协议：本地 RustFS/MinIO，生产 OSS）=====
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_AUDIO=audio
S3_BUCKET_RECORDING=recording
S3_USE_PATH_STYLE=true          # 本地 RustFS/MinIO 用 true / OSS 用 false

# ===== LLM（OpenAI 兼容）=====
# 仅开发/冒烟调试用；生产不需要（BYOK：Key 在客户端，服务端不持有）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== Azure Speech =====
# 同上，仅开发调试用；生产不需要（BYOK）
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast

# ===== 服务 =====
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080   # 预签名 URL 生成基准
JWT_SECRET=change-me-in-.env.dev        # 仅开发用随机串；生产必须改
